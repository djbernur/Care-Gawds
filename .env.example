# Public site URL used for canonical links, sitemap, and Open Graph.
NEXT_PUBLIC_SITE_URL=https://caregawds.com

# Where form submissions are delivered (JSON POST). Leave unset until a storage
# service is chosen; in production the forms then politely refuse submissions
# instead of losing them.
WAITLIST_WEBHOOK_URL=
CAREGIVER_APPLICATION_WEBHOOK_URL=

# Show clearly labeled example caregiver profiles in the directory.
# Use only for local development or preview deployments, never production.
NEXT_PUBLIC_SHOW_DEMO_PROFILES=false
